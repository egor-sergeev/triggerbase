{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "triggerbase-relay-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "analytics_engine_datasets": [
    { "binding": "QUEUE_METRICS", "dataset": "triggerbase_queue_staging" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Account",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Account"],
    },
  ],
  "env": {
    "production": {
      "name": "triggerbase-relay",
      "analytics_engine_datasets": [
        { "binding": "QUEUE_METRICS", "dataset": "triggerbase_queue" }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ACCOUNTS",
            "class_name": "Account",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "EDGE_LIMIT",
          "namespace_id": "1002",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
      ],
    },
  },
  "ratelimits": [
    {
      "name": "EDGE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
}
